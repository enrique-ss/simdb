# Configuração de Ambiente — Kindred

# Seleção do Modo de Execução:
# "local" = Usa o banco de dados SQLite local (npm run setup / asset)
# "supabase" = Usa o Supabase em nuvem
APP_MODE=local

# Credenciais do Supabase (Obrigatório se APP_MODE=supabase)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Porta do Servidor Backend Local
PORT=3000

# Conta que receberá o papel de administrador ao ser cadastrada.
# Deixe vazio para não conceder administração automaticamente.
ADMIN_EMAIL=
